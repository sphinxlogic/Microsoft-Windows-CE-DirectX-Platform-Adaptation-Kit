//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_DIRECTX             ICON    DISCARDABLE     dxview.ico
IDI_CAPS                ICON    DISCARDABLE     folder.ico
IDI_CAPSOPEN            ICON    DISCARDABLE     folderop.ico
IDI_DIRECTX_NODE        ICON    DISCARDABLE     dxnode.ico

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

ID_MENU MENU DISCARDABLE
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&About",                      IDM_ABOUT
        MENUITEM SEPARATOR

#ifdef SUPPORT_FULL_PRINTING
        MENUITEM "&Print Caps",                 IDM_PRINT
        MENUITEM "Print &All Caps",             IDM_PRINTALL
        MENUITEM "Print to &File",              IDM_PRINTTOFILE
#else
        MENUITEM "&Print Current View to File", IDM_PRINTTOFILE
#endif
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "A&vailable caps only",        IDM_VIEWAVAIL
        MENUITEM "&All caps",                   IDM_VIEWALL
    END
END


