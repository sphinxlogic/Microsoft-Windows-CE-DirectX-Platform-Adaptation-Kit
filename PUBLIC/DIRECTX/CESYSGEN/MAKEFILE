cleanup_quartz::
	@set CLEANUP_ROOT=$(SG_OUTPUT_ROOT)

cleanup_quartz:: cleanup_quartz_tree

cleanup_quartz_directx::
	@set CLEANUP_ROOT=$(_PUBLICROOT)\directx

cleanup_quartz_directx:: cleanup_quartz_tree

cleanup_quartz_tree: 
	@echo Cleaning up quartz files in %%CLEANUP_ROOT%%...
	@pushd .
	@
	@chdir %%CLEANUP_ROOT%%\oak\lib\$(_CPUINDPATH)
	-@$(CLEANCMD) quartz*.* amovie.* 
	-@$(CLEANCMD) msadpcm.* imaadpcm.* pcmconv.* msgsm610.* msg711.* msrle32.* 
	@
	@chdir %%CLEANUP_ROOT%%\sdk\lib\$(_CPUINDPATH)
	-@$(CLEANCMD) msacmce.* icm.* mmtimer.* 
	-@$(CLEANCMD) strmiids.* strmbase.* amstrmid.*
	@
	@chdir %%CLEANUP_ROOT%%\oak\target\$(_CPUINDPATH)
	-@$(CLEANCMD) /s quartz*.* amovie.* amstream.* strmdll.* 
	-@$(CLEANCMD) strmsamp.* playit.* oplayit.* ceplayit.* ddxclmv.* 
	-@$(CLEANCMD) msadpcm.* imaadpcm.* pcmconv.* msgsm610.* msg711.* msrle32.* 
	-@$(CLEANCMD) iccvid.* msaud32.* mpg4ds32.* l3filter.* sl_anet.* 
	-@$(CLEANCMD) msacmce.* icm.* mmtimer.*
	@
	@chdir %%CLEANUP_ROOT%%\sdk\inc
	-@$(CLEANCMD) amaudio.* amfilter.* amstream.* amvideo.* austream.* aviriff.* cache.* combase.* comlite.* control.* ctlutil.* cutlist.* ddstream.* dvdmedia.* edevdefs.* errors.* evcode.* fourcc.* ksuuids.* measure.* mmstream.* mpconfig.* mpegtype.* msgthrd.* mtype.* outputq.* pstream.* pullpin.* refclock.* reftime.* renbase.* schedule.* seekpt.* source.* streams.* strmctl.*  strmif.* sysclock.* transfrm.* transip.* uuids.* vfwmsgs.* videoctl.* vpconfig.* vpnotify.* vptype.* vtrans.* winctrl.* winutil.* winx.* wxdebug.* wxlist.* wxutil.* 
	@
	@chdir  %%CLEANUP_ROOT%%\oak\inc
	-@$(CLEANCMD) quartz.* ks.* ksmedia.* kspin.*
	-@popd
	
