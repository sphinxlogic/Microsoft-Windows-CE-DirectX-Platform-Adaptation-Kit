quartz0 quartz1 quartz2::
	@set SOURCELIBS=

quartz0::$(QUARTZ_CORE_COMPONENTS)
quartz1::$(QUARTZ1_COMPONENTS)
quartz2::$(QUARTZ2_COMPONENTS)	

quartz0 quartz1 quartz2:: 
	@set TARGETNAME=$@
	@set RELEASETYPE=OAK
	@set TARGETLIBS=
	@set TARGETTYPE=LIBRARY
	$(MAKE) /NOLOGO $(SG_OUTPUT_OAKLIB)\$@.lib
	@set QUARTZLIBS=%%QUARTZLIBS%% $(SG_OUTPUT_OAKLIB)\$@.lib

$(SG_OUTPUT_OAKTGT)\quartz.obj: $(DX_OAKLIB)\quartz.cpp $(SG_OUTPUT_ROOT)\sdk\inc\ceconfig.h
	-del $(SG_OUTPUT_OAKLIB)\quartz?.lib
	@type <<
$(CXXCOMPILER) -I$(SG_OUTPUT_ROOT)\oak\inc -I$(SG_OUTPUT_ROOT)\sdk\inc $(CONLY_FLAGS) -Fo$@ $(CFLAGS)  $(DX_OAKLIB)\quartz.cpp
<<NOKEEP
	@$(CXXCOMPILER) @<<
-I$(SG_OUTPUT_ROOT)\oak\inc -I$(SG_OUTPUT_ROOT)\sdk\inc $(CONLY_FLAGS) -Fo$@
$(CFLAGS: =
) $(DX_OAKLIB)\quartz.cpp
<<NOKEEP

