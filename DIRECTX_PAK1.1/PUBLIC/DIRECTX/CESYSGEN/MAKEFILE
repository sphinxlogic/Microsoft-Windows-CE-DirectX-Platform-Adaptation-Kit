	-del $(SG_OUTPUT_OAKLIB)\msdxm.res
	@set WMP_RES_FILES=-c $(SG_INPUT_LIB)\msdxm.res %%WMP_RES_FILES%%
	@echo res2res %%WMP_RES_FILES%% -fo $(SG_OUTPUT_OAKLIB)\msdxm.res
	@res2res %%WMP_RES_FILES%% -fo $(SG_OUTPUT_OAKLIB)\msdxm.res

