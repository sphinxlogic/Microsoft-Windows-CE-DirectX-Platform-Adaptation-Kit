cleanup_dxmasf::
	@set CLEANUP_ROOT=$(SG_OUTPUT_ROOT)

cleanup_dxmasf:: cleanup_quartz_tree

cleanup_dxmasf_directx::
	@set CLEANUP_ROOT=$(_PUBLICROOT)\directx

cleanup_dxmasf_directx:: cleanup_dxmasf_tree

cleanup_dxmasf_tree: 
	@echo Cleaning up wmt files in %%CLEANUP_ROOT%%...
	@pushd .
	@
	@chdir %%CLEANUP_ROOT%%\oak\lib\$(_CPUINDPATH)
	-@$(CLEANCMD) dxmasf*.* strmdll.* nserror.* wsasock.* 
	@
	@chdir %%CLEANUP_ROOT%%\sdk\lib\$(_CPUINDPATH)
	-@$(CLEANCMD) dxmasf*.* strmdll.* nserror.* wsasock.* 
	@
	@chdir %%CLEANUP_ROOT%%\oak\target\$(_CPUINDPATH)
	-@$(CLEANCMD) dxmasf*.* strmdll.* nserror.* wsasock.*
	@
	@chdir %%CLEANUP_ROOT%%\sdk\inc
	-@$(CLEANCMD) qnetwork.* playlist.*
	@
	@chdir  %%CLEANUP_ROOT%%\oak\inc
	-@popd

dxmasf:: 
	@set TARGETNAME=$@
	@set RELEASETYPE=OAK
	@set TARGETLIBS=
	@set TARGETTYPE=LIBRARY
	$(MAKE) /NOLOGO $(SG_OUTPUT_OAKLIB)\$@.lib
	@set DXMASFLIBS=%%DXMASFLIBS%% $(SG_OUTPUT_OAKLIB)\$@.lib

DXMASF_DEFINES=

$(SG_OUTPUT_OAKTGT)\dxmasf.obj: $(DX_OAKLIB)\dxmasf.cpp $(DX_OAKINC)\dxmasf.h $(SG_OUTPUT_ROOT)\sdk\inc\ceconfig.h
	-del $(SG_OUTPUT_OAKLIB)\dxmasf?.lib
	@type <<
$(CXXCOMPILER) -I$(SG_OUTPUT_ROOT)\oak\inc -I$(SG_OUTPUT_ROOT)\sdk\inc $(DXMASF_DEFINES) $(CONLY_FLAGS) -Fo$@ $(CFLAGS)  $(DX_OAKLIB)\dxmasf.cpp
<<NOKEEP
	@$(CXXCOMPILER) @<<
-I$(SG_OUTPUT_ROOT)\oak\inc -I$(SG_OUTPUT_ROOT)\sdk\inc $(DXMASF_DEFINES) $(CONLY_FLAGS) -Fo$@
$(CFLAGS: =
) $(DX_OAKLIB)\dxmasf.cpp
<<NOKEEP

