; @CESYSGEN IF DIRECTX_MODULES_DIRECTSOUND

IF INITNODIRECTSOUND !
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; DirectSound core components
;   This dll is the main server component in the CE DirectSound
;   architecture.  It will be loaded as a filesystem driver into
;   device.exe and processes which wish to use DirectSound services
;   will link to the client-side DSound.dll which will proxy 
;   calls to DSoundS.dll via DeviceIOCTL's.
;   It's order is set to 3 because it should be loaded after the
;   appropriate wavedev driver and before the wavebuff 
;   and waveapi dll's.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\DSOUNDS]
   "Prefix"="DSS"
   "Dll"="DSoundS.dll"
   "Index"=dword:0
   "Order"=dword:3

ENDIF

; @CESYSGEN ENDIF


; @CESYSGEN IF DIRECTX_MODULES_MXAT
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Mixer API Test Driver
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\Mixers]
   "Prefix"="MIX"
   "Dll"="mxat.dll"
   "Index"=dword:0
   "Order"=dword:0
; @CESYSGEN ENDIF

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; DirectSound driver entries
;   These drivers are ordinary wavedev drivers which support being
;   opened at 44kHz, 16bit stereo, as require by the current 
;   DirectSound API's.
;   The appropriate wavedev driver is registered as WAV, index=9
;   because this is where DSoundS.dll attempts to look for a 
;   wavedev driver (the fake wavebuff emulation driver is at index=1).
;   It's order is set to 0 because it should be loaded before the
;   DSoundS component.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; @CESYSGEN IF DIRECTX_MODULES_IDSES1371
IF DSHAL_ES1371
[HKEY_LOCAL_MACHINE\Drivers\Dsound\ES1371]
   "clsid"="{EFE5F0F1-568A-11d3-AC7F-00105A017FE1}"
   "Dll"="idses1371.dll"
   "Desc"="AudioPCI ES1371 DSound Driver"

[HKEY_LOCAL_MACHINE\Drivers\DsoundCapture\ES1371]
   "clsid"="{C5225EF4-0D6C-4327-82C1-578A70BBF09F}"
   "Dll"="idses1371.dll"
   "Desc"="AudioPCI ES1371 DSound Capture Driver"
ENDIF
; @CESYSGEN ENDIF

; @CESYSGEN IF DIRECTX_MODULES_IGS5000
IF DSWAVE_IGS5000
[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\IGS5000]
   "Prefix"="WAV"
   "Dll"="igs5000.dll"
   "Index"=dword:9
   "Order"=dword:0
ENDIF
; @CESYSGEN ENDIF

; @CESYSGEN IF DIRECTX_MODULES_ES1371
IF DSWAVE_ES1371
[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\ES1371]
   "Prefix"="WAV"
   "Dll"="es1371.dll"
   "Index"=dword:9
   "Order"=dword:0
ENDIF
; @CESYSGEN ENDIF


; @CESYSGEN IF DIRECTX_MODULES_IDSWAVE
IF DSHAL_WAVEDEV
[HKEY_LOCAL_MACHINE\Drivers\Dsound\Wavedev]
   "clsid"="{0363EF42-3B57-11d3-AC79-00105A017FE1}"
   "Dll"="idswave.dll"
   "Desc"="Wavedev DSound HAL Emulator"
ENDIF
; @CESYSGEN ENDIF


; @CESYSGEN IF DIRECTX_MODULES_WAVEBUFF

IF INITNODIRECTSOUND !
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; DirectSound waveOut emulation
;   This dll emulates a wavedev driver to the waveOut API's but
;   actually opens a DirectSound secondary buffer to allow
;   waveOut sounds to be mixed with other DirectSound buffers.
;   It is registered as WAV, index=1 because this is where the
;   coreos attempts to look for a wavedev driver.
;   It's order is set to 4 because it should be loaded after the
;   DSoundS component which we'll set to order 3.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\WAVEBUFF]
   "Prefix"="WAV"
   "Dll"="wavebuff.dll"
   "Index"=dword:1
   "Order"=dword:4

; Note: in order for the load ordering of drivers in device.exe
; to be correct, we must also overide the registry entry
; for waveapi.dll that was in common.reg.  
; We need to have waveapi.dll load after wavebuff
; has loaded, so we set order to 5 here.
[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\WAPIMAN]
   "Prefix"="WAM"
   "Dll"="waveapi.dll"
   "Index"=dword:1
   "Order"=dword:5

; END OF DirectSound waveOut emulation

ENDIF

; @CESYSGEN ENDIF


