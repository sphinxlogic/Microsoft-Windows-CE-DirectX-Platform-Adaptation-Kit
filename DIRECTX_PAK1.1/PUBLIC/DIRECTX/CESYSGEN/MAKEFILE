	@set DLLENTRY=DllMain
	@set TARGETLIBS=$(OWNLIB)

cleanup_quartz::
	@set CLEANUP_ROOT=$(SG_OUTPUT_ROOT)

cleanup_quartz:: cleanup_quartz_tree

cleanup_quartz_directx::
	@set CLEANUP_ROOT=$(_PUBLICROOT)\directx

cleanup_quartz_directx:: cleanup_quartz_tree

MSDXM_FILES=\
	amovie.* msdxm.* amcompat.* vrctl.* wmp*.res

QUARTZ_FILES=\
	quartz*.* amstream.* strmdll.* msacmce.* icm.* mmtimer.* \
	strmiids.* strmbase.* amstrmid.* \
	$(MSDXM_FILES)

QUARTZ_CODEC_FILES=\
	msadpcm.* imaadpcm.* pcmconv.* msgsm610.* msg711.* msrle32.* \
	iccvid.* msaud32.* mpg4ds32.* l3filter.* sl_anet.* 

QUARTZ_SAMPLE_FILES=\
	strmsamp.* playall.* playwnd.* ceplayit.* ddxclmv.*

QUARTZ_SDK_FILES=\
	amaudio.* amfilter.* amstream.* amvideo.* austream.* aviriff.* \
	cache.* combase.* comlite.* control.* ctlutil.* cutlist.* ddstream.* \
	edevdefs.* errors.* evcode.* fourcc.* ksuuids.* measure.* mmstream.* mpconfig.* \
	mpegtype.* msgthrd.* mtype.* outputq.* pstream.* pullpin.* refclock.* reftime.* \
	renbase.* schedule.* seekpt.* source.* streams.* strmctl.*  strmif.* sysclock.* \
	transfrm.* transip.* uuids.* vfwmsgs.* videoctl.* vpconfig.* vpnotify.* vptype.* \
	vtrans.* winctrl.* winutil.* winx.* wxdebug.* wxlist.* wxutil.* 

QUARTZ_OAK_FILES=\
	quartz.* ks.* ksmedia.* kspin.*

cleanup_quartz_tree: 
	@echo Cleaning up quartz files in %%CLEANUP_ROOT%%...
	@pushd .
	@
	@chdir %%CLEANUP_ROOT%%\oak\lib\$(_CPUINDPATH)
	-@$(CLEANCMD) $(QUARTZ_FILES) $(QUARTZ_CODEC_FILES) 
	@
	@chdir %%CLEANUP_ROOT%%\sdk\lib\$(_CPUINDPATH)
	-@$(CLEANCMD) /s $(QUARTZ_FILES)
	@
	@chdir %%CLEANUP_ROOT%%\oak\target\$(_CPUINDPATH)
	-@$(CLEANCMD) /s $(QUARTZ_FILES) $(QUARTZ_CODEC_FILES) $(QUARTZ_SAMPLE_FILES) 
	@
	@chdir %%CLEANUP_ROOT%%\sdk\inc
	-@$(CLEANCMD) $(QUARTZ_SDK_FILES) 
	@
	@chdir  %%CLEANUP_ROOT%%\oak\inc
	-@$(CLEANCMD) $(QUARTZ_OAK_FILES) 
	-@popd
	
