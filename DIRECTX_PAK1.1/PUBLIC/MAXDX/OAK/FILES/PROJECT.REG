;;; Add a TEST Printer ;;;;;;;;;;;;;

; Settings for 'MaxAll Test Color Printer'
[HKEY_LOCAL_MACHINE\Printers\MaxAll Test Color Printer]
    "Driver"="pcl.dll"
    "High Quality"="300"
    "Draft Quality"="75"
    "Color"="Color"

[HKEY_LOCAL_MACHINE\Ident]
    "Name"=LOC_IDENT_NAME
    "Desc"=LOC_IDENT_DESC


[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\Serial]
   "Tsp"="Unimodem.dll"
   "DeviceArrayIndex"=dword:0
   "Prefix"="COM"
   "Dll"="Serial.Dll"
   "Order"=dword:0
   "DeviceType"=dword:0
   "FriendlyName"=LOC_FRIENDLY_SERIAL
   "DevConfig"=hex: 10,00, 00,00, 05,00,00,00, 10,01,00,00, 00,4B,00,00, 00,00, 08, 00, 00, 00,00,00,00

[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\IrCOMM]
   "Tsp"="Unimodem.dll"
   "Dll"="IRCOMM.DLL"
   "Prefix"="COM"
   "Order"=dword:1
   "Index"=dword:3
   "DeviceType"=dword:6
   "FriendlyName"=LOC_FRIENDLY_IRCOMM
   "DevConfig"=hex: 10,00, 00,00, 02,00,00,00, 10,01,00,00, 00,4B,00,00, 00,00, 08, 00, 00, 00,00,00,00

[HKEY_CURRENT_USER\ControlPanel\Volume]
    "Key"=dword:0	; Keyclicks: 1=soft, 0x10002=loud
    "Screen"=dword:0	; ScreenTaps: 1=soft, 0x10002=loud

; Default display driver
[HKEY_LOCAL_MACHINE\HARDWARE\DEVICEMAP\TOUCH]
IF _TGTPLAT=PC !
IF _TGTPLAT=CEPC !
IF _TGTPLAT=PUZZLE !
"DriverName"="touch.dll"
ENDIF
ENDIF
ENDIF
IF _TGTPLAT=PC
"DriverName"="keybddr.dll"
ENDIF
IF _TGTPLAT=PUZZLE
"DriverName"="keybddr.dll"
ENDIF
IF _TGTPLAT=CEPC
"DriverName"="keybddr.dll"
ENDIF

; Redirector settings
[HKEY_LOCAL_MACHINE\Comm\Redir]
   ; Expose \NETWORK dir for mapped resources
   "RegisterFSRoot"=dword:1

;
; ACM Drivers
;
[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\CODEC_CEGSM]
   "Prefix"="ACM"
   "Dll"="cegsm.dll"
   "Index"=dword:1
   "Order"=dword:0

[HKEY_LOCAL_MACHINE\Drivers\BuiltIn\FILTER]
   "Prefix"="ACM"
   "Dll"="msfilter.dll"
   "Index"=dword:2
   "Order"=dword:0


; Set memory thresholds for Hibernate
[HKEY_LOCAL_MACHINE\SYSTEM\Hibernate]
	"Bytes"=dword:20000
	"Pages"=dword:28

