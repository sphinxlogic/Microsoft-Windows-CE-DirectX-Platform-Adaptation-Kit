CDEFINES=$(CDEFINES) -DDDI -D$(_TGTPLAT) 

!IF "$(FBBPP)"==""
CDEFINES=$(CDEFINES) 
!ELSE
CDEFINES=$(CDEFINES) -D$(FBBPP)
!ENDIF

!IF "$(DO_DISPPERF)"=="1"
CDEFINES=$(CDEFINES) -DDO_DISPPERF
!ENDIF

#
# Define ENABLE_ACCELERATION if HW acceleration is desired.
#
# Note: VIRGE_ROP_BUG
#	The 2D Line Draw with a ROP of "P" does NOT draw the whole line.
# A portion of the line contains the last color pattern drawn. In order
# to get around this, The Mono Pattern Foreground Color register is set
# to the inverse of the passed color pattern, and the ROP code of Inverted 
# Pattern "Pn" is used.
#
#	The Rectangle Fill with a ROP of "P" does NOT fill the whole rectangle.
# A portion of the rectangle contains the last color pattern drawn. In order
# to get around this, The Mono Pattern Foreground Color register is set to 
# the inverse of the passed color pattern, and the ROP code of Inverted 
# Pattern "Pn" is used.
#
CDEFINES=$(CDEFINES) -DDDI -D$(_TGTPLAT) -DVIRGE_ROP_BUG -DENABLE_ACCELERATION 

PRECOMPILED_INCLUDE=precomp.h
PRECOMPILED_PCH=precomp.pch
PRECOMPILED_CXX=1

