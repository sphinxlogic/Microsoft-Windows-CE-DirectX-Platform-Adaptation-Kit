cleanup_dsound::
	@set CLEANUP_ROOT=$(SG_OUTPUT_ROOT)

cleanup_dsound:: cleanup_dsound_tree

cleanup_dsound_directx::
	@set CLEANUP_ROOT=$(_PUBLICROOT)\directx

cleanup_dsound_directx:: cleanup_dsound_tree

cleanup_dsound_tree: 
	echo Cleaning up dsound files in %%CLEANUP_ROOT%%...
	@pushd .
	@
	@chdir %%CLEANUP_ROOT%%\oak\lib\$(_CPUINDPATH)
	-@$(CLEANCMD) $(DSOUND_TARGETS)
	@
	@chdir %%CLEANUP_ROOT%%\sdk\lib\$(_CPUINDPATH)
	-@$(CLEANCMD) $(DSOUND_TARGETS)
	@
	@chdir %%CLEANUP_ROOT%%\oak\target\$(_CPUINDPATH)
	-@$(CLEANCMD) $(DSOUND_TARGETS)
	@
	@chdir %%CLEANUP_ROOT%%\sdk\inc
	-@$(CLEANCMD) $(DSOUND_TARGETS)
	@
	@chdir  %%CLEANUP_ROOT%%\oak\inc
	-@popd

